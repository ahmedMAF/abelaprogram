<Window x:Class="Abela.App.Views.SupplierEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات المورد" Height="580" Width="480" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer Padding="20">
        <StackPanel>
            <TextBlock Text="كود المورد"/>
            <TextBox x:Name="CodeBox" Margin="0,4,0,10"/>
            <TextBlock Text="اسم المورد *"/>
            <TextBox x:Name="NameBox" Margin="0,4,0,10"/>
            <TextBlock Text="اسم الشركة"/>
            <TextBox x:Name="CompanyBox" Margin="0,4,0,10"/>
            <TextBlock Text="رقم الهاتف"/>
            <TextBox x:Name="PhoneBox" Margin="0,4,0,10"/>
            <TextBlock Text="رقم واتساب (اختياري)"/>
            <TextBox x:Name="WhatsAppBox" Margin="0,4,0,10"/>
            <TextBlock Text="البريد الإلكتروني (اختياري)"/>
            <TextBox x:Name="EmailBox" Margin="0,4,0,10"/>
            <TextBlock Text="العنوان"/>
            <TextBox x:Name="AddressBox" Margin="0,4,0,10"/>
            <TextBlock Text="الرقم الضريبي (اختياري)"/>
            <TextBox x:Name="TaxNumberBox" Margin="0,4,0,10"/>
            <TextBlock Text="الرصيد الافتتاحي"/>
            <TextBox x:Name="OpeningBalanceBox" Margin="0,4,0,10"/>
            <TextBlock Text="ملاحظات"/>
            <TextBox x:Name="NotesBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,10"/>
            <CheckBox x:Name="IsActiveCheck" Content="فعال" Margin="0,0,0,10"/>
            <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Width="100" Click="Save_Click" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Width="100" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
