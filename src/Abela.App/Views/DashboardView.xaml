<UserControl x:Class="Abela.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="لوحة التحكم" Style="{StaticResource PageTitle}"/>

            <!-- Shortcuts -->
            <WrapPanel Margin="0,0,0,16">
                <Button Content="فاتورة بيع جديدة" Style="{StaticResource PrimaryButton}" Command="{Binding NewSaleCommand}" Margin="0,0,8,8" Visibility="{Binding CanAddSale, Converter={StaticResource BoolToVis}}"/>
                <Button Content="فاتورة شراء جديدة" Style="{StaticResource PrimaryButton}" Command="{Binding NewPurchaseCommand}" Margin="0,0,8,8" Visibility="{Binding CanAddPurchase, Converter={StaticResource BoolToVis}}"/>
                <Button Content="إضافة منتج" Style="{StaticResource SuccessButton}" Command="{Binding NewProductCommand}" Margin="0,0,8,8" Visibility="{Binding CanAddProduct, Converter={StaticResource BoolToVis}}"/>
                <Button Content="إضافة عميل" Style="{StaticResource SuccessButton}" Command="{Binding NewCustomerCommand}" Margin="0,0,8,8" Visibility="{Binding CanAddCustomer, Converter={StaticResource BoolToVis}}"/>
                <Button Content="إضافة مورد" Style="{StaticResource SuccessButton}" Command="{Binding NewSupplierCommand}" Margin="0,0,8,8" Visibility="{Binding CanAddSupplier, Converter={StaticResource BoolToVis}}"/>
                <Button Content="تسجيل مصروف" Style="{StaticResource SecondaryButton}" Command="{Binding NewExpenseCommand}" Margin="0,0,8,8" Visibility="{Binding CanAddExpense, Converter={StaticResource BoolToVis}}"/>
                <Button Content="عرض التقارير" Style="{StaticResource SecondaryButton}" Command="{Binding ViewReportsCommand}" Margin="0,0,8,8" Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>

            <!-- Stat cards -->
            <UniformGrid Columns="4" Rows="2" Margin="0,0,0,16">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="مبيعات اليوم" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TodaySales, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="مشتريات اليوم" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TodayPurchases, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="مصروفات اليوم" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TodayExpenses, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="صافي الحركة التقريبي" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding NetToday, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="عدد المنتجات" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ProductsCount}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="عدد العملاء" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CustomersCount}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ديون العملاء" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CustomerDebts, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="ديون للموردين" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding SupplierDebts, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Chart -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="المبيعات خلال آخر 7 أيام" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding SalesChart}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="180"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="70" VerticalAlignment="Bottom" Margin="6,0">
                                    <TextBlock Text="{Binding Value, StringFormat={}{0:N0}}" HorizontalAlignment="Center" FontSize="10"/>
                                    <Border Background="{StaticResource PrimaryBrush}" Height="{Binding BarHeight}" CornerRadius="3,3,0,0"/>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="المنتجات منخفضة المخزون" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding LowStock}" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinLevel}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="آخر عمليات البيع" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding RecentSales}" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم" Binding="{Binding Number}" Width="90"/>
                                <DataGridTextColumn Header="العميل" Binding="{Binding Party}" Width="*"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="آخر عمليات الشراء" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding RecentPurchases}" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم" Binding="{Binding Number}" Width="90"/>
                            <DataGridTextColumn Header="المورد" Binding="{Binding Party}" Width="*"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
