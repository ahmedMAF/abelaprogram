<UserControl x:Class="Abela.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="حركة المخزون" Style="{StaticResource PageTitle}"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,8,0"/>
            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,8,0"/>
            <ComboBox Width="180" ItemsSource="{Binding Products}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProductFilter}" Margin="0,0,8,0"/>
            <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
            <Button Content="جرد وتسوية مخزون" Style="{StaticResource SuccessButton}" Command="{Binding NewStockAdjustmentCommand}" Visibility="{Binding CanAdjust, Converter={StaticResource BoolToVis}}"/>
        </WrapPanel>
        <DataGrid ItemsSource="{Binding Movements}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                <DataGridTextColumn Header="المنتج" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="نوع الحركة" Binding="{Binding TransactionType, Converter={StaticResource InventoryTransactionTypeConv}}" Width="140"/>
                <DataGridTextColumn Header="قبل" Binding="{Binding QuantityBefore}" Width="70"/>
                <DataGridTextColumn Header="التغيير" Binding="{Binding QuantityChange}" Width="70"/>
                <DataGridTextColumn Header="بعد" Binding="{Binding QuantityAfter}" Width="70"/>
                <DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceType, Converter={StaticResource ReferenceTypeConv}}" Width="120"/>
                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
