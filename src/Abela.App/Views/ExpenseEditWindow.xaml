<Window x:Class="Abela.App.Views.ExpenseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مصروف" Height="640" Width="440" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="التاريخ"/>
            <DatePicker x:Name="DatePickerBox" Margin="0,4,0,10"/>

            <TextBlock Text="التصنيف *"/>
            <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" Margin="0,4,0,10"/>

            <TextBlock Text="الوصف *"/>
            <TextBox x:Name="DescriptionBox" Margin="0,4,0,10"/>

            <TextBlock Text="المبلغ *"/>
            <TextBox x:Name="AmountBox" Margin="0,4,0,10"/>

            <TextBlock Text="طريقة الدفع"/>
            <ComboBox x:Name="MethodCombo" Margin="0,4,0,10"/>

            <TextBlock Text="الجهة المستلمة (اختياري)"/>
            <TextBox x:Name="PayeeBox" Margin="0,4,0,10"/>

            <TextBlock Text="رقم مرجعي (اختياري)"/>
            <TextBox x:Name="ReferenceBox" Margin="0,4,0,10"/>

            <TextBlock Text="ملاحظات"/>
            <TextBox x:Name="NotesBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,10"/>

            <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Width="100" Click="Save_Click" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Width="100" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
