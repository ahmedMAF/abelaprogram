<Window x:Class="Abela.App.Views.ExpenseCategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تصنيفات المصروفات" Height="480" Width="420" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="NameBox" Width="220" Margin="0,0,8,0"/>
            <Button Content="إضافة" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0,0,8,0"/>
            <Button Content="حذف" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
        </StackPanel>
        <ListBox x:Name="CategoriesList" DisplayMemberPath="Name"/>
    </DockPanel>
</Window>
