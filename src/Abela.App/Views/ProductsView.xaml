<UserControl x:Class="Abela.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="المنتجات" Style="{StaticResource PageTitle}"/>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBox Width="220" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                     ToolTip="ابحث بالاسم أو الكود أو الباركود"/>
            <ComboBox Width="160" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategoryFilter}" Margin="0,0,8,0"/>
            <CheckBox Content="منخفض المخزون فقط" IsChecked="{Binding LowStockOnly}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
            <Button Content="إضافة منتج" Style="{StaticResource SuccessButton}" Command="{Binding AddCommand}" Margin="0,0,8,0" Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"/>
            <Button Content="تعديل" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" Margin="0,0,8,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
            <Button Content="تعطيل" Style="{StaticResource SecondaryButton}" Command="{Binding DeactivateCommand}" Margin="0,0,8,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
            <Button Content="حذف" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
            <Button Content="التصنيفات" Style="{StaticResource SecondaryButton}" Command="{Binding ManageCategoriesCommand}" Margin="0,0,8,0"/>
            <Button Content="الوحدات" Style="{StaticResource SecondaryButton}" Command="{Binding ManageUnitsCommand}"/>
        </WrapPanel>

        <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="90"/>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="التصنيف" Binding="{Binding Category.Name}" Width="120"/>
                <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit.Name}" Width="80"/>
                <DataGridTextColumn Header="سعر الشراء" Binding="{Binding PurchasePrice, StringFormat={}{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat={}{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="الكمية" Binding="{Binding CurrentQuantity}" Width="80"/>
                <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinStockLevel}" Width="80"/>
                <DataGridCheckBoxColumn Header="يتطلب رقم تسلسلي" Binding="{Binding RequiresSerialNumber}" Width="120" ElementStyle="{StaticResource AppCheckBoxStyle}" EditingElementStyle="{StaticResource AppCheckBoxStyle}"/>
                <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsActive}" Width="60" ElementStyle="{StaticResource AppCheckBoxStyle}" EditingElementStyle="{StaticResource AppCheckBoxStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
