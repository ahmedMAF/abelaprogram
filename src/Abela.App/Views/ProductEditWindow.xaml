<Window x:Class="Abela.App.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات المنتج" Height="650" Width="520"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="كود المنتج"/>
            <TextBox x:Name="CodeBox" Margin="0,4,0,10"/>

            <TextBlock Text="الباركود (اختياري)"/>
            <TextBox x:Name="BarcodeBox" Margin="0,4,0,10"/>

            <TextBlock Text="اسم المنتج *"/>
            <TextBox x:Name="NameBox" Margin="0,4,0,10"/>

            <TextBlock Text="التصنيف *"/>
            <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" Margin="0,4,0,10"/>

            <TextBlock Text="الوحدة *"/>
            <ComboBox x:Name="UnitCombo" DisplayMemberPath="Name" Margin="0,4,0,10"/>

            <TextBlock Text="وصف مختصر"/>
            <TextBox x:Name="DescriptionBox" Margin="0,4,0,10" TextWrapping="Wrap" Height="50" AcceptsReturn="True"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="سعر الشراء *"/>
                    <TextBox x:Name="PurchasePriceBox" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="سعر البيع *"/>
                    <TextBox x:Name="SalePriceBox" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="QtyLabel" Text="الكمية الحالية"/>
                    <TextBox x:Name="QuantityBox" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="الحد الأدنى للمخزون"/>
                    <TextBox x:Name="MinStockBox" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="الشركة المصنعة (اختياري)"/>
                    <TextBox x:Name="BrandBox" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="رقم الموديل (اختياري)"/>
                    <TextBox x:Name="ModelBox" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="مدة الضمان بالأشهر (اختياري)"/>
            <TextBox x:Name="WarrantyBox" Margin="0,4,0,10"/>

            <CheckBox x:Name="RequiresSerialCheck" Content="هذا المنتج يتطلب رقمًا تسلسليًا لكل قطعة" Margin="0,0,0,10"/>

            <CheckBox x:Name="IsActiveCheck" Content="فعال" Margin="0,0,0,10"/>

            <TextBlock Text="ملاحظات"/>
            <TextBox x:Name="NotesBox" Margin="0,4,0,10" TextWrapping="Wrap" Height="50" AcceptsReturn="True"/>

            <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Width="100" Click="Save_Click" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Width="100" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
