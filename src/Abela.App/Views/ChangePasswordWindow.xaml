<Window x:Class="Abela.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور" Height="380" Width="380"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock x:Name="HeaderText" Text="يجب تغيير كلمة المرور الافتراضية قبل المتابعة" TextWrapping="Wrap"
                   FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,16"/>

        <TextBlock Text="كلمة المرور الحالية" Margin="0,0,0,4"/>
        <PasswordBox x:Name="CurrentPasswordBox" Margin="0,0,0,12"/>

        <TextBlock Text="كلمة المرور الجديدة" Margin="0,0,0,4"/>
        <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,12"/>

        <TextBlock Text="تأكيد كلمة المرور الجديدة" Margin="0,0,0,4"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,12"/>

        <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Width="100" Click="Save_Click" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="إلغاء" Style="{StaticResource SecondaryButton}" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
