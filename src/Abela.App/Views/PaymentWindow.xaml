<Window x:Class="Abela.App.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سند" Height="480" Width="420" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
    <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"/>

        <TextBlock Text="الجهة *"/>
        <ComboBox x:Name="PartyCombo" DisplayMemberPath="Name" Margin="0,4,0,10" IsEditable="True" IsTextSearchEnabled="True"/>

        <TextBlock Text="المبلغ *"/>
        <TextBox x:Name="AmountBox" Margin="0,4,0,10"/>

        <TextBlock Text="طريقة الدفع"/>
        <ComboBox x:Name="MethodCombo" Margin="0,4,0,10"/>

        <TextBlock Text="رقم مرجعي (اختياري)"/>
        <TextBox x:Name="ReferenceBox" Margin="0,4,0,10"/>

        <TextBlock Text="ملاحظات"/>
        <TextBox x:Name="NotesBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,10"/>

        <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Width="100" Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
