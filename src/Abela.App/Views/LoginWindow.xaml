<Window x:Class="Abela.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Abela - تسجيل الدخول" Height="480" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow" FlowDirection="RightToLeft">
    <Grid Background="#111827">
        <Border Background="White" CornerRadius="12" Margin="24" Padding="32">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Abela" FontSize="34" FontWeight="Bold" Foreground="#1F6FEB" HorizontalAlignment="Center"/>
                <TextBlock Text="نظام إدارة المبيعات والمخزون" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,28"/>

                <TextBlock Text="اسم المستخدم" Margin="0,0,0,4" FontWeight="Bold"/>
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="كلمة المرور" Margin="0,0,0,4" FontWeight="Bold"/>
                <Grid Margin="0,0,0,6">
                    <PasswordBox x:Name="PasswordBox" Visibility="Visible"/>
                    <TextBox x:Name="PasswordVisibleBox" Visibility="Collapsed"/>
                </Grid>
                <CheckBox x:Name="ShowPasswordCheck" Content="إظهار كلمة المرور" Margin="0,0,0,10" Checked="ShowPasswordCheck_Changed" Unchecked="ShowPasswordCheck_Changed"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10"/>

                <Button Content="تسجيل الدخول" Style="{StaticResource PrimaryButton}" Height="42"
                        Click="LoginButton_Click"/>

                <TextBlock Text="admin / Admin@123 (افتراضي عند أول تشغيل)" FontSize="10" Foreground="#9CA3AF"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
