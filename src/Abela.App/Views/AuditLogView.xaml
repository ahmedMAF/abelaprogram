<UserControl x:Class="Abela.App.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="سجل النشاط" Style="{StaticResource PageTitle}"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,8,0"/>
            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,8,0"/>
            <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}"/>
        </WrapPanel>
        <DataGrid ItemsSource="{Binding Logs}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150"/>
                <DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="120"/>
                <DataGridTextColumn Header="نوع العملية" Binding="{Binding ActionType}" Width="100"/>
                <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="الجهاز" Binding="{Binding MachineName}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
