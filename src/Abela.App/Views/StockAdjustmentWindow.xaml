<Window x:Class="Abela.App.Views.StockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="جرد وتسوية مخزون" Height="620" Width="800" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="جرد وتسوية المخزون" Style="{StaticResource PageTitle}"/>
        <TextBlock Grid.Row="1" Text="أدخل الكمية الفعلية للأصناف التي تريد تسويتها فقط، سيتم احتساب الفرق تلقائيًا." TextWrapping="Wrap" Margin="0,0,0,10"/>

        <DataGrid x:Name="ItemsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="الكمية بالنظام" Binding="{Binding SystemQuantity}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="الكمية الفعلية" Binding="{Binding ActualQuantity, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn Header="الفرق" Binding="{Binding Difference}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="السبب" Binding="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="ملاحظات عامة" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="NotesBox" Width="400"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" MaxWidth="350"/>
            <Button Content="تنفيذ التسوية" Style="{StaticResource PrimaryButton}" Width="140" Click="Execute_Click" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
