<UserControl x:Class="Abela.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="التقارير" Style="{StaticResource PageTitle}"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <ComboBox Width="220" ItemsSource="{Binding ReportTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedReportType}" Margin="0,0,8,0"/>
            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,8,0"/>
            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,8,0"/>
            <Button Content="عرض التقرير" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" Margin="0,0,8,0"/>
            <Button Content="تصدير PDF" Style="{StaticResource SecondaryButton}" Command="{Binding ExportPdfCommand}" Margin="0,0,8,0"/>
            <Button Content="تصدير Excel" Style="{StaticResource SecondaryButton}" Command="{Binding ExportExcelCommand}"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ReportTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding FinancialSummaryText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"
                   Visibility="{Binding FinancialSummaryText, Converter={StaticResource StringToVis}}"/>
        <DataGrid x:Name="ResultGrid" ItemsSource="{Binding ResultRows}" AutoGenerateColumns="True" AutoGeneratingColumn="ResultGrid_AutoGeneratingColumn"/>
    </DockPanel>
</UserControl>
