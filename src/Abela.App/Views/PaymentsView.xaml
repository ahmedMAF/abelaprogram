<UserControl x:Class="Abela.App.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="الدفعات" Style="{StaticResource PageTitle}"/>
        <TabControl>
            <TabItem Header="دفعات العملاء (سندات قبض)">
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Top" Content="سند قبض جديد" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Margin="0,0,0,10"
                            Command="{Binding NewCustomerPaymentCommand}" Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"/>
                    <DataGrid ItemsSource="{Binding CustomerPayments}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم السند" Binding="{Binding ReceiptNumber}" Width="110"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding PaymentDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer.Name}" Width="*"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="90"/>
                            <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="100"/>
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="دفعات الموردين (سندات دفع)">
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Top" Content="سند دفع جديد" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Margin="0,0,0,10"
                            Command="{Binding NewSupplierPaymentCommand}" Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"/>
                    <DataGrid ItemsSource="{Binding SupplierPayments}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="110"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding PaymentDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                            <DataGridTextColumn Header="المورد" Binding="{Binding Supplier.Name}" Width="*"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="90"/>
                            <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="100"/>
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
