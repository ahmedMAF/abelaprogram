<Window x:Class="Abela.App.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مستخدم" Height="440" Width="400" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="اسم المستخدم *"/>
        <TextBox x:Name="UsernameBox" Margin="0,4,0,10"/>

        <TextBlock x:Name="PasswordLabel" Text="كلمة المرور *"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,4,0,10"/>

        <TextBlock Text="الاسم الكامل *"/>
        <TextBox x:Name="FullNameBox" Margin="0,4,0,10"/>

        <TextBlock Text="الدور *"/>
        <ComboBox x:Name="RoleCombo" DisplayMemberPath="Name" Margin="0,4,0,10"/>

        <CheckBox x:Name="IsActiveCheck" Content="فعال" Margin="0,0,0,10"/>

        <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Width="100" Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
