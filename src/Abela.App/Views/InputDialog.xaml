<Window x:Class="Abela.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدخال" Height="220" Width="420" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="InputBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="موافق" Style="{StaticResource PrimaryButton}" Width="90" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
