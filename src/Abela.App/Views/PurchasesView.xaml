<UserControl x:Class="Abela.App.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="فواتير المشتريات" Style="{StaticResource PageTitle}"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,8,0"/>
            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,8,0"/>
            <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
            <Button Content="فاتورة شراء جديدة" Style="{StaticResource SuccessButton}" Command="{Binding NewInvoiceCommand}" Margin="0,0,8,0" Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"/>
            <Button Content="طباعة / PDF" Style="{StaticResource SecondaryButton}" Command="{Binding PrintInvoiceCommand}" Margin="0,0,8,0"/>
            <Button Content="إلغاء الفاتورة" Style="{StaticResource DangerButton}" Command="{Binding CancelInvoiceCommand}" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
        </WrapPanel>
        <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="110"/>
                <DataGridTextColumn Header="رقم فاتورة المورد" Binding="{Binding SupplierInvoiceNumber}" Width="120"/>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                <DataGridTextColumn Header="المورد" Binding="{Binding Supplier.Name}" Width="*"/>
                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat={}{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat={}{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
