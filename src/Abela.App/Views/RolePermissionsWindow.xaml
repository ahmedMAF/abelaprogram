<Window x:Class="Abela.App.Views.RolePermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الأدوار والصلاحيات" Height="640" Width="640" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="إدارة الأدوار والصلاحيات" Style="{StaticResource PageTitle}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="الدور" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="RoleCombo" Width="220" DisplayMemberPath="Name" SelectionChanged="RoleCombo_SelectionChanged" Margin="0,0,16,0"/>
            <TextBox x:Name="NewRoleNameBox" Width="180" Margin="0,0,8,0"/>
            <Button Content="إضافة دور جديد" Style="{StaticResource SecondaryButton}" Click="AddRole_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PermissionsPanel"/>
        </ScrollViewer>

        <Button Grid.Row="3" Content="حفظ الصلاحيات" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Width="140" Margin="0,10,0,0" Click="Save_Click"/>
    </Grid>
</Window>
